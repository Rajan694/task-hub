{
  "name": "task-hub",
  "displayName": "Task Hub",
  "description": "Every command your project can run, one click away: npm, pnpm, yarn and bun scripts, Makefile, just, Taskfile, docker compose, Django, Poe, PDM, Maven, Gradle, shell and PowerShell scripts and VS Code tasks, with live status, stop, restart, dev-server links and ordered groups.",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#14213d",
    "theme": "dark"
  },
  "publisher": "rajan694",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rajan694/task-hub.git"
  },
  "bugs": {
    "url": "https://github.com/Rajan694/task-hub/issues"
  },
  "homepage": "https://github.com/Rajan694/task-hub#readme",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tasks",
    "task runner",
    "npm scripts",
    "pnpm",
    "yarn",
    "monorepo",
    "makefile",
    "justfile",
    "taskfile",
    "docker compose",
    "django",
    "maven",
    "gradle",
    "spring boot",
    "shell scripts",
    "powershell",
    "dev server"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, Task Hub lists commands but does not run them, because running project scripts executes code from the repository."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Task Hub runs commands as local processes, so it needs the files on disk."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskHub",
          "title": "Task Hub",
          "icon": "assets/activitybar.svg"
        }
      ]
    },
    "views": {
      "taskHub": [
        {
          "id": "taskHub.commands",
          "name": "Commands"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "taskHub.commands",
        "contents": "Open a folder to see the commands it can run.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "taskHub.commands",
        "contents": "No runnable commands found in this workspace yet.\n[Refresh](command:taskHub.refresh)",
        "when": "workbenchState != empty && taskHub.scanned"
      }
    ],
    "commands": [
      {
        "command": "taskHub.run",
        "title": "Run",
        "category": "Task Hub",
        "icon": "$(play)"
      },
      {
        "command": "taskHub.runWithArgs",
        "title": "Run with Arguments…",
        "category": "Task Hub",
        "icon": "$(play)"
      },
      {
        "command": "taskHub.stop",
        "title": "Stop",
        "category": "Task Hub",
        "icon": "$(debug-stop)"
      },
      {
        "command": "taskHub.restart",
        "title": "Restart",
        "category": "Task Hub",
        "icon": "$(debug-restart)"
      },
      {
        "command": "taskHub.openUrl",
        "title": "Open in Browser",
        "category": "Task Hub",
        "icon": "$(globe)"
      },
      {
        "command": "taskHub.showOutput",
        "title": "Show Output",
        "category": "Task Hub",
        "icon": "$(output)"
      },
      {
        "command": "taskHub.goToDefinition",
        "title": "Go to Definition",
        "category": "Task Hub",
        "icon": "$(go-to-file)"
      },
      {
        "command": "taskHub.copyCommand",
        "title": "Copy Command",
        "category": "Task Hub",
        "icon": "$(copy)"
      },
      {
        "command": "taskHub.saveAsCommand",
        "title": "Save as Command…",
        "category": "Task Hub",
        "icon": "$(bookmark)"
      },
      {
        "command": "taskHub.deleteSavedCommand",
        "title": "Delete Saved Command",
        "category": "Task Hub",
        "icon": "$(trash)"
      },
      {
        "command": "taskHub.addFavorite",
        "title": "Add to Favorites",
        "category": "Task Hub",
        "icon": "$(star-empty)"
      },
      {
        "command": "taskHub.removeFavorite",
        "title": "Remove from Favorites",
        "category": "Task Hub",
        "icon": "$(star-full)"
      },
      {
        "command": "taskHub.addToGroup",
        "title": "Add to Group…",
        "category": "Task Hub",
        "icon": "$(list-ordered)"
      },
      {
        "command": "taskHub.runGroup",
        "title": "Run Group",
        "category": "Task Hub",
        "icon": "$(play)"
      },
      {
        "command": "taskHub.stopGroup",
        "title": "Stop Group",
        "category": "Task Hub",
        "icon": "$(debug-stop)"
      },
      {
        "command": "taskHub.deleteGroup",
        "title": "Delete Group",
        "category": "Task Hub",
        "icon": "$(trash)"
      },
      {
        "command": "taskHub.loadAllTasks",
        "title": "Load All Tasks",
        "category": "Task Hub",
        "icon": "$(list-unordered)"
      },
      {
        "command": "taskHub.serviceLogs",
        "title": "Logs",
        "category": "Task Hub",
        "icon": "$(list-flat)"
      },
      {
        "command": "taskHub.serviceStop",
        "title": "Stop Service",
        "category": "Task Hub",
        "icon": "$(debug-stop)"
      },
      {
        "command": "taskHub.addCommand",
        "title": "Add Command",
        "category": "Task Hub",
        "icon": "$(add)"
      },
      {
        "command": "taskHub.refresh",
        "title": "Refresh",
        "category": "Task Hub",
        "icon": "$(refresh)"
      },
      {
        "command": "taskHub.quickRun",
        "title": "Run Command…",
        "category": "Task Hub"
      },
      {
        "command": "taskHub.stopAll",
        "title": "Stop All Commands",
        "category": "Task Hub",
        "icon": "$(debug-stop)"
      },
      {
        "command": "taskHub.openSettings",
        "title": "Settings",
        "category": "Task Hub",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "taskHub.run",
          "when": "false"
        },
        {
          "command": "taskHub.stop",
          "when": "false"
        },
        {
          "command": "taskHub.restart",
          "when": "false"
        },
        {
          "command": "taskHub.openUrl",
          "when": "false"
        },
        {
          "command": "taskHub.showOutput",
          "when": "false"
        },
        {
          "command": "taskHub.goToDefinition",
          "when": "false"
        },
        {
          "command": "taskHub.copyCommand",
          "when": "false"
        },
        {
          "command": "taskHub.runWithArgs",
          "when": "false"
        },
        {
          "command": "taskHub.saveAsCommand",
          "when": "false"
        },
        {
          "command": "taskHub.deleteSavedCommand",
          "when": "false"
        },
        {
          "command": "taskHub.serviceLogs",
          "when": "false"
        },
        {
          "command": "taskHub.serviceStop",
          "when": "false"
        },
        {
          "command": "taskHub.addFavorite",
          "when": "false"
        },
        {
          "command": "taskHub.removeFavorite",
          "when": "false"
        },
        {
          "command": "taskHub.addToGroup",
          "when": "false"
        },
        {
          "command": "taskHub.runGroup",
          "when": "false"
        },
        {
          "command": "taskHub.stopGroup",
          "when": "false"
        },
        {
          "command": "taskHub.deleteGroup",
          "when": "false"
        },
        {
          "command": "taskHub.loadAllTasks",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "taskHub.refresh",
          "when": "view == taskHub.commands",
          "group": "navigation@1"
        },
        {
          "command": "taskHub.addCommand",
          "when": "view == taskHub.commands",
          "group": "navigation@2"
        },
        {
          "command": "taskHub.openSettings",
          "when": "view == taskHub.commands",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "taskHub.openUrl",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\.running\\.url(\\+|$)/",
          "group": "inline@1"
        },
        {
          "command": "taskHub.run",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\.(idle|passed|failed|stopped)(\\+|$)/",
          "group": "inline@2"
        },
        {
          "command": "taskHub.showOutput",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\.failed(\\+|$)/",
          "group": "inline@3"
        },
        {
          "command": "taskHub.serviceLogs",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\.up\\+/",
          "group": "inline@4"
        },
        {
          "command": "taskHub.serviceStop",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\.up\\+/",
          "group": "inline@5"
        },
        {
          "command": "taskHub.stop",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\.running/",
          "group": "inline@6"
        },
        {
          "command": "taskHub.restart",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\.running/",
          "group": "inline@7"
        },
        {
          "command": "taskHub.run",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\.(idle|passed|failed|stopped)(\\+|$)/",
          "group": "1_run@1"
        },
        {
          "command": "taskHub.runWithArgs",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\.(idle|passed|failed|stopped)(\\+|$)/ && viewItem =~ /\\+args/",
          "group": "1_run@2"
        },
        {
          "command": "taskHub.stop",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\.running/",
          "group": "1_run@3"
        },
        {
          "command": "taskHub.restart",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\.running/",
          "group": "1_run@4"
        },
        {
          "command": "taskHub.openUrl",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\.running\\.url(\\+|$)/",
          "group": "1_run@5"
        },
        {
          "command": "taskHub.showOutput",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\.(running|passed|failed|stopped)/",
          "group": "1_run@6"
        },
        {
          "command": "taskHub.serviceLogs",
          "when": "view == taskHub.commands && viewItem =~ /\\+service/",
          "group": "2_service@1"
        },
        {
          "command": "taskHub.serviceStop",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\.up\\+/",
          "group": "2_service@2"
        },
        {
          "command": "taskHub.goToDefinition",
          "when": "view == taskHub.commands && viewItem =~ /^(cmd\\.|rungroup\\.|group\\.file(\\+|$))/",
          "group": "3_navigate@1"
        },
        {
          "command": "taskHub.copyCommand",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\./",
          "group": "4_copy@1"
        },
        {
          "command": "taskHub.saveAsCommand",
          "when": "view == taskHub.commands && viewItem =~ /\\+savable/",
          "group": "4_copy@2"
        },
        {
          "command": "taskHub.deleteSavedCommand",
          "when": "view == taskHub.commands && viewItem =~ /\\+saved/",
          "group": "6_saved@1"
        },
        {
          "command": "taskHub.addFavorite",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\.(?!.*\\+fav)/",
          "group": "5_favorites@1"
        },
        {
          "command": "taskHub.removeFavorite",
          "when": "view == taskHub.commands && viewItem =~ /\\+fav/",
          "group": "5_favorites@1"
        },
        {
          "command": "taskHub.runGroup",
          "when": "view == taskHub.commands && viewItem == rungroup.idle",
          "group": "inline@2"
        },
        {
          "command": "taskHub.stopGroup",
          "when": "view == taskHub.commands && viewItem == rungroup.running",
          "group": "inline@6"
        },
        {
          "command": "taskHub.loadAllTasks",
          "when": "view == taskHub.commands && viewItem =~ /\\+loadall/",
          "group": "inline@1"
        },
        {
          "command": "taskHub.runGroup",
          "when": "view == taskHub.commands && viewItem == rungroup.idle",
          "group": "1_run@1"
        },
        {
          "command": "taskHub.stopGroup",
          "when": "view == taskHub.commands && viewItem == rungroup.running",
          "group": "1_run@2"
        },
        {
          "command": "taskHub.loadAllTasks",
          "when": "view == taskHub.commands && viewItem =~ /\\+loadall/",
          "group": "1_run@7"
        },
        {
          "command": "taskHub.addToGroup",
          "when": "view == taskHub.commands && viewItem =~ /^cmd\\./",
          "group": "5_favorites@2"
        },
        {
          "command": "taskHub.deleteGroup",
          "when": "view == taskHub.commands && viewItem =~ /^rungroup\\./",
          "group": "6_saved@2"
        }
      ]
    },
    "configuration": {
      "title": "Task Hub",
      "properties": {
        "taskHub.sources": {
          "type": "array",
          "description": "Which command sources are detected.",
          "items": {
            "type": "string",
            "enum": [
              "npm",
              "make",
              "just",
              "taskfile",
              "compose",
              "vscode",
              "saved",
              "python",
              "script",
              "maven",
              "gradle"
            ]
          },
          "uniqueItems": true,
          "default": [
            "npm",
            "make",
            "just",
            "taskfile",
            "compose",
            "vscode",
            "saved",
            "python",
            "script",
            "maven",
            "gradle"
          ]
        },
        "taskHub.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.venv/**",
            "**/dist/**",
            "**/target/**",
            "**/build/**",
            "**/.vscode-test/**"
          ],
          "markdownDescription": "Glob patterns of folders that are never scanned. Folders hidden by `files.exclude` are skipped too."
        },
        "taskHub.longRunningNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "dev",
            "start",
            "serve",
            "watch",
            "run",
            "bootRun",
            "spring-boot:run"
          ],
          "description": "Command names treated as long-running: Task Hub watches them for a port and offers restart."
        },
        "taskHub.revealTerminal": {
          "type": "string",
          "enum": [
            "never",
            "onFailure",
            "always"
          ],
          "default": "onFailure",
          "description": "When to show a command's terminal."
        },
        "taskHub.notify": {
          "type": "string",
          "enum": [
            "failures",
            "all",
            "never"
          ],
          "default": "failures",
          "description": "Which finished commands show a notification."
        },
        "taskHub.openUrlIn": {
          "type": "string",
          "enum": [
            "externalBrowser",
            "simpleBrowser"
          ],
          "enumDescriptions": [
            "Your default browser.",
            "VS Code's built-in Simple Browser."
          ],
          "default": "externalBrowser",
          "description": "Where the Open in Browser button opens a dev-server URL."
        },
        "taskHub.storage": {
          "type": "string",
          "enum": [
            "workspaceFile",
            "private"
          ],
          "enumDescriptions": [
            "Save commands, groups and favorites in .vscode/task-hub.json, so the team can commit and share them.",
            "Save them in VS Code's workspace state, only on this machine."
          ],
          "default": "workspaceFile",
          "description": "Where saved commands, groups and favorites are stored."
        },
        "taskHub.scripts.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.sh",
            "**/*.bash",
            "**/*.ps1",
            "**/*.bat",
            "**/*.cmd"
          ],
          "description": "Glob patterns of files listed as scripts. .bat and .cmd files are listed on Windows only."
        },
        "taskHub.scripts.runFrom": {
          "type": "string",
          "enum": [
            "scriptFolder",
            "workspaceRoot"
          ],
          "default": "scriptFolder",
          "description": "Folder a script runs in."
        },
        "taskHub.scripts.maxFiles": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Stop listing scripts after this many, so big repositories stay fast."
        },
        "taskHub.gradle.defaultTasks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "build",
            "test",
            "clean",
            "assemble"
          ],
          "description": "Gradle tasks shown before Load all tasks."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.102.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "ovsx": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
